# Common kernel configuration
# This is intentionally a starter set and must be refined for the exact ChromiumOS branch.

CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_MODULES=y
CONFIG_BLK_DEV_SD=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
# eMMC: Arasan SDHCI (&sdhci) and its PHY
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_PHY_ROCKCHIP_EMMC=y
# microSD (&sdmmc) and the Wi-Fi SDIO bus (&sdio0): DesignWare MMC
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
# RK3399 has a single PCIe controller (pcie0) for the M.2 slot
CONFIG_PCIE_ROCKCHIP_HOST=y
CONFIG_PHY_ROCKCHIP_PCIE=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
# Audio: Everest ES8316 codec on I2S1, simple-audio-card
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_ES8316=m
CONFIG_SND_SIMPLE_CARD=m
# Wi-Fi/Bluetooth: AMPAK AP6256 (Broadcom BCM43456 Wi-Fi on SDIO, BCM4345C5 BT on UART0)
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_RTC_CLASS=y
CONFIG_REGMAP=y
CONFIG_MFD_SYSCON=y
CONFIG_DEBUG_FS=y
