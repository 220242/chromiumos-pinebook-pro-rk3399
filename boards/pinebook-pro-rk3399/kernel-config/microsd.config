# microSD-specific kernel fragment
# Not used by the build: kernel/pinebook-pro.config in the board overlay is
# the kernel fragment that goes into the image. Kept for reference.
# The PineBook Pro microSD slot is on the RK3399 DesignWare MMC controller (&sdmmc).
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_TEST=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
