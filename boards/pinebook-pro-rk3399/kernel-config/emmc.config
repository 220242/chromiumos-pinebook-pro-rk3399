# eMMC-specific kernel fragment
# Not used by the build: kernel/pinebook-pro.config in the board overlay is
# the kernel fragment that goes into the image. Kept for reference.
# The PineBook Pro eMMC is on the RK3399 Arasan SDHCI controller (&sdhci).
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_PHY_ROCKCHIP_EMMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_TEST=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
