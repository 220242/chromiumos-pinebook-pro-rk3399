# Applied on top of configs/pinebook-pro-rk3399_defconfig.
#
# Boot ChromiumOS first: load /boot/pinebook-pro/boot.scr from ROOT-A
# (partition 3) of the microSD card (mmc 1), then the eMMC (mmc 0). If neither
# has one, fall back to the standard boot flow so other OSes still boot.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="for d in 1 0; do if load mmc ${d}:3 ${scriptaddr} /boot/pinebook-pro/boot.scr; then setenv devtype mmc; setenv devnum ${d}; source ${scriptaddr}; fi; done; bootflow scan -lb"
CONFIG_CMD_PART=y
CONFIG_CMD_EXT4=y
CONFIG_FS_EXT4=y
# Host tool not needed here; skipping it avoids a gnutls build dependency.
# CONFIG_TOOLS_MKEFICAPSULE is not set
