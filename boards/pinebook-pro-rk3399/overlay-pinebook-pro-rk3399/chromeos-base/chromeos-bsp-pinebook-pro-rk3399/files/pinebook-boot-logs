#
# Bring-up aid: copy this boot's logs to logs/boot-NNNN/ on the EFI-SYSTEM
# partition (FAT, partition 12 of the boot disk), which Windows can read.
# Runs from the start of boot until shutdown, every second for the first two
# minutes, then every 30 seconds. Keeps the last 10 boots.

mnt=/run/pinebook-boot-logs

disk=$(rootdev -s -d 2>/dev/null) || exit 0
case ${disk} in
*[0-9]) esp=${disk}p12 ;;
*) esp=${disk}12 ;;
esac
for _ in $(seq 50); do
	[[ -b ${esp} ]] && break
	sleep 0.1
done

mkdir -p "${mnt}"
mount -t vfat -o rw,noatime,flush,umask=022 "${esp}" "${mnt}" || exit 0

logs=${mnt}/logs
mkdir -p "${logs}"
n=$(( $(cat "${logs}/last-boot" 2>/dev/null || echo 0) + 1 ))
echo "${n}" > "${logs}/last-boot"
out=$(printf '%s/boot-%04d' "${logs}" "${n}")
mkdir -p "${out}"
ls -d "${logs}"/boot-* | head -n -10 | xargs -r rm -rf
cat /proc/cmdline > "${out}/cmdline.txt"
sync

start=$(date +%s)
while :; do
	dmesg > "${out}/dmesg.txt" 2>&1
	{ uptime; echo; initctl list; echo; mount; } > "${out}/state.txt" 2>&1
	for f in /run/*.log /run/chromeos_startup* /var/log/messages \
		/var/log/boot.log /var/log/ui/ui.LATEST /var/log/chrome/chrome \
		/var/log/power_manager/powerd.LATEST /var/log/tpm*.log \
		/mnt/stateful_partition/unencrypted/clobber*.log \
		/mnt/stateful_partition/unencrypted/preserve/*.log; do
		[[ -f ${f} ]] || continue
		name=${f#/}
		cp -f "${f}" "${out}/${name//\//_}.txt" 2>/dev/null
	done
	sync
	if (( $(date +%s) - start < 120 )); then sleep 1; else sleep 30; fi
done
