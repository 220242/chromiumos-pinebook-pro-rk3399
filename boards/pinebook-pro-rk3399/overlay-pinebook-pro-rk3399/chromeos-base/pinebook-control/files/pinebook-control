    "api_key": ("GOOGLE_API_KEY", r"[A-Za-z0-9_-]{20,80}"),
    "client_id": ("GOOGLE_DEFAULT_CLIENT_ID",
                  r"[0-9]+-[a-z0-9]+\.apps\.googleusercontent\.com"),
