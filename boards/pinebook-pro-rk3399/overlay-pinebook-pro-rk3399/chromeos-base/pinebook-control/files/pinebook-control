"""Pinebook Pro control service, behind the Pinebook app.

Runs as root from the upstart job pinebook-control and serves the app at
http://pinebook.localhost:8086/ (localhost only):

GET  /api/status    CPU and GPU frequencies and load, temperatures, battery
                    and estimated power, memory, and which programs use the
                    GPU and the hardware video decoders.
GET  /api/settings  The saved settings and what the hardware allows.
POST /api/settings  Saves and applies the CPU/GPU limits right away, and
                    writes or removes the boot-time tuning (overclock,
                    undervolt).

Limits (governor, maximum frequency) are applied through cpufreq and devfreq
at every start of the service. Overclocking and undervolting change the OPP
tables in the device tree, so they take effect at the next boot: the service
writes pinebook-tune.scr (a U-Boot script of fdt commands) to the card's
EFI-SYSTEM partition, and the board's boot.scr runs it. Deleting that file
(from any computer: EFI-SYSTEM is FAT) brings back the stock tables.

POST requests need the X-Pinebook header (which a page from another origin
cannot send without a CORS preflight, and this server answers none) and a
matching Origin; every request needs a localhost Host header.
"""

import http.server
import json
import logging
import os
import re
import socket
import struct
import subprocess
import sys
import tempfile
import threading
import time
import zlib

PORT = 8086
HOSTS = ("pinebook.localhost", "localhost", "127.0.0.1", "[::1]")
ORIGINS = tuple("http://%s:%d" % (h, PORT) for h in HOSTS)
WEB = "/usr/share/pinebook-control/web"
STATE_DIR = "/var/lib/pinebook-control"
SETTINGS_FILE = STATE_DIR + "/settings.json"
RUN = "/run/pinebook-control"
TUNE_NAME = "pinebook-tune.scr"
ESP_PART = 12

CPUFREQ = "/sys/devices/system/cpu/cpufreq"
GPU_DEVFREQ = "/sys/class/devfreq/ff9a0000.gpu"
DT = "/sys/firmware/devicetree/base"

log = logging.getLogger("pinebook-control")

# Stock OPP tables of rk3399-pinebook-pro.dtb (kernel 6.6): (Hz, microvolts),
# and the highest voltage each table allows.
STOCK = {
    "little": {
        "node": "/opp-table-0",
        "vmax": 1250000,
        "opps": [(408000000, 825000), (600000000, 825000),
                 (816000000, 850000), (1008000000, 925000),
                 (1200000000, 1000000), (1416000000, 1125000)],
    },
    "big": {
        "node": "/opp-table-1",
        "vmax": 1250000,
        "opps": [(408000000, 825000), (600000000, 825000),
                 (816000000, 825000), (1008000000, 875000),
                 (1200000000, 950000), (1416000000, 1025000),
                 (1608000000, 1100000), (1800000000, 1200000)],
    },
    "gpu": {
        "node": "/opp-table-2",
        "vmax": 1150000,
        "opps": [(200000000, 825000), (297000000, 825000),
                 (400000000, 825000), (500000000, 875000),
                 (600000000, 925000), (800000000, 1100000)],
    },
}

# Extra OPPs per overclock level: (Hz, microvolts). The rates are in the
# RK3399 PLL tables; the regulators allow 1.35 V (little) and 1.5 V (big).
OVERCLOCK = {
    "off": {},
    "mild": {"little": [(1512000000, 1200000)],
             "big": [(1992000000, 1250000)]},
    "strong": {"little": [(1512000000, 1200000), (1608000000, 1275000)],
               "big": [(1992000000, 1250000), (2088000000, 1300000)]},
}
UNDERVOLT_STEPS = (0, 25, 50, 75, 100)
VMIN = 800000

PROFILES = ("powersave", "balanced", "performance", "custom")

DEFAULTS = {
    "profile": "balanced",
    "custom": {
        "little_max": None, "big_max": None, "cpu_governor": "schedutil",
        "gpu_max": None, "gpu_governor": "simple_ondemand",
    },
    "tune": {"overclock": "off", "cpu_undervolt_mv": 0,
             "gpu_undervolt_mv": 0},
}


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def read_int(path, default=None):
    v = read(path)
    try:
        return int(v)
    except (TypeError, ValueError):
        return default


def write(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(value))
        return True
    except OSError as e:
        log.warning("write %s=%s: %s", path, value, e)
        return False


# --- Hardware -----------------------------------------------------------

def policies():
    """cpufreq policies: little (A53, cpu0-3) first, big (A72, cpu4-5)."""
    out = []
    for name in sorted(os.listdir(CPUFREQ)) if os.path.isdir(CPUFREQ) else []:
        p = os.path.join(CPUFREQ, name)
        cpus = [int(c) for c in (read(p + "/related_cpus") or "").split()]
        if not cpus:
            continue
        out.append({
            "id": "little" if 0 in cpus else "big",
            "path": p,
            "cpus": cpus,
        })
    return out


def avail_freqs(path):
    return sorted(int(x) for x in
                  (read(path + "/scaling_available_frequencies") or "").split())


def gpu_freqs():
    return sorted(int(x) for x in
                  (read(GPU_DEVFREQ + "/available_frequencies") or "").split())


def clamp_to(freqs, want):
    """The highest available frequency not above want (None: the highest)."""
    if not freqs:
        return None
    if want is None:
        return freqs[-1]
    ok = [f for f in freqs if f <= want]
    return ok[-1] if ok else freqs[0]


def profile_limits(settings):
    """Governors and maximum frequencies for the chosen profile."""
    prof = settings.get("profile", "balanced")
    pol = {p["id"]: p for p in policies()}
    lf = avail_freqs(pol["little"]["path"]) if "little" in pol else []
    bf = avail_freqs(pol["big"]["path"]) if "big" in pol else []
    gf = gpu_freqs()
    if prof == "powersave":
        return {"cpu_governor": "schedutil",
                "little_max": clamp_to(lf, 1008000), "big_max": clamp_to(bf, 1200000),
                "gpu_governor": "simple_ondemand", "gpu_max": clamp_to(gf, 400000000)}
    if prof == "performance":
        return {"cpu_governor": "performance",
                "little_max": clamp_to(lf, None), "big_max": clamp_to(bf, None),
                "gpu_governor": "performance", "gpu_max": clamp_to(gf, None)}
    if prof == "custom":
        c = settings.get("custom", {})
        return {"cpu_governor": c.get("cpu_governor") or "schedutil",
                "little_max": clamp_to(lf, c.get("little_max")),
                "big_max": clamp_to(bf, c.get("big_max")),
                "gpu_governor": c.get("gpu_governor") or "simple_ondemand",
                "gpu_max": clamp_to(gf, c.get("gpu_max"))}
    return {"cpu_governor": "schedutil",
            "little_max": clamp_to(lf, None), "big_max": clamp_to(bf, None),
            "gpu_governor": "simple_ondemand", "gpu_max": clamp_to(gf, None)}


def apply_limits(settings):
    lim = profile_limits(settings)
    for p in policies():
        govs = (read(p["path"] + "/scaling_available_governors") or "").split()
        if lim["cpu_governor"] in govs:
            write(p["path"] + "/scaling_governor", lim["cpu_governor"])
        mx = lim["%s_max" % p["id"]]
        if mx:
            write(p["path"] + "/scaling_max_freq", mx)
    if os.path.isdir(GPU_DEVFREQ):
        govs = (read(GPU_DEVFREQ + "/available_governors") or "").split()
        if lim["gpu_governor"] in govs:
            write(GPU_DEVFREQ + "/governor", lim["gpu_governor"])
        if lim["gpu_max"]:
            write(GPU_DEVFREQ + "/max_freq", lim["gpu_max"])
    log.info("Applied %s: %s", settings.get("profile"), lim)
    return lim


# --- Boot-time tuning (EFI-SYSTEM) ---------------------------------------

def tune_tables(tune):
    """The OPP tables a tuning gives: {table: [(Hz, uV, vmax), ...]}."""
    oc = OVERCLOCK.get(tune.get("overclock"), {})
    out = {}
    for name, t in STOCK.items():
        off = 1000 * int(tune.get("gpu_undervolt_mv" if name == "gpu"
                                  else "cpu_undervolt_mv") or 0)
        rows = []
        for hz, uv in t["opps"] + oc.get(name, []):
            v = max(uv - off, VMIN)
            rows.append((hz, v, max(t["vmax"], v)))
        out[name] = rows
    return out


def tune_script(tune):
    lines = ["# %s %s" % (TUNE_NAME, json.dumps(tune, sort_keys=True)),
             'echo "pinebook-tune: overclock %s, CPU -%s mV, GPU -%s mV"' % (
                 tune.get("overclock"), tune.get("cpu_undervolt_mv"),
                 tune.get("gpu_undervolt_mv"))]
    for name, rows in tune_tables(tune).items():
        node = STOCK[name]["node"]
        nstock = len(STOCK[name]["opps"])
        for i, (hz, v, vmax) in enumerate(rows):
            path = "%s/opp%02d" % (node, i)
            if i >= nstock:
                lines.append("fdt mknode %s opp%02d" % (node, i))
                lines.append("fdt set %s opp-hz <0x%x 0x%x>" % (
                    path, hz >> 32, hz & 0xffffffff))
            elif v == STOCK[name]["opps"][i][1]:
                continue
            lines.append("fdt set %s opp-microvolt <0x%x 0x%x 0x%x>" % (
                path, v, v, vmax))
    return "\n".join(lines) + "\n"


def uimage_script(text):
    """A U-Boot legacy script image, as `mkimage -T script` makes."""
    data = text.encode()
    payload = struct.pack(">II", len(data), 0) + data
    hdr = struct.pack(">IIIIIIIBBBB32s", 0x27051956, 0, int(time.time()),
                      len(payload), 0, 0, zlib.crc32(payload) & 0xffffffff,
                      5, 22, 6, 0, b"pinebook-tune")  # linux, arm64, script
    hcrc = zlib.crc32(hdr) & 0xffffffff
    return hdr[:4] + struct.pack(">I", hcrc) + hdr[8:] + payload


def boot_disk():
    try:
        dev = subprocess.run(["rootdev", "-s", "-d"], capture_output=True,
                             text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None
    return dev or None


def esp_device():
    disk = boot_disk()
    if not disk:
        return None
    sep = "p" if disk[-1].isdigit() else ""
    dev = "%s%s%d" % (disk, sep, ESP_PART)
    return dev if os.path.exists(dev) else None


class EspMount:
    """EFI-SYSTEM, mounted for the duration of a with block."""

    def __enter__(self):
        self.dev = esp_device()
        if not self.dev:
            raise RuntimeError("EFI-SYSTEM partition not found")
        os.makedirs(RUN, exist_ok=True)
        self.dir = tempfile.mkdtemp(dir=RUN, prefix="esp.")
        subprocess.run(["mount", "-t", "vfat", "-o",
                        "nosuid,nodev,noexec,umask=0022", self.dev, self.dir],
                       check=True, capture_output=True)
        return self.dir

    def __exit__(self, *exc):
        subprocess.run(["umount", self.dir], capture_output=True)
        os.rmdir(self.dir)


def tune_is_stock(tune):
    return (tune.get("overclock", "off") == "off"
            and not tune.get("cpu_undervolt_mv")
            and not tune.get("gpu_undervolt_mv"))


def write_tune(tune):
    with EspMount() as esp:
        path = os.path.join(esp, TUNE_NAME)
        if tune_is_stock(tune):
            if os.path.exists(path):
                os.remove(path)
            log.info("Removed %s", TUNE_NAME)
        else:
            tmp = path + ".new"
            with open(tmp, "wb") as f:
                f.write(uimage_script(tune_script(tune)))
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, path)
            log.info("Wrote %s: %s", TUNE_NAME, tune)
        subprocess.run(["sync"])


def read_tune_file():
    """The tuning saved on EFI-SYSTEM (None: none, stock tables)."""
    try:
        with EspMount() as esp:
            with open(os.path.join(esp, TUNE_NAME), "rb") as f:
                data = f.read()
    except (OSError, RuntimeError, subprocess.CalledProcessError):
        return None
    m = re.search(rb"# %s (\{[^\n]*\})" % TUNE_NAME.encode(), data)
    try:
        return json.loads(m.group(1)) if m else {"unknown": True}
    except ValueError:
        return {"unknown": True}


def running_tables():
    """The OPP tables the kernel booted with: {table: [(MHz, mV), ...]}."""
    out = {}
    for name, t in STOCK.items():
        base = DT + t["node"]
        rows = []
        for opp in sorted(os.listdir(base)) if os.path.isdir(base) else []:
            try:
                with open(os.path.join(base, opp, "opp-hz"), "rb") as f:
                    hz = int.from_bytes(f.read()[:8], "big")
                with open(os.path.join(base, opp, "opp-microvolt"), "rb") as f:
                    uv = int.from_bytes(f.read()[:4], "big")
            except OSError:
                continue
            rows.append((hz // 1000000, uv // 1000))
        out[name] = rows
    return out


# --- Settings -------------------------------------------------------------

def load_settings():
    s = json.loads(json.dumps(DEFAULTS))
    try:
        with open(SETTINGS_FILE) as f:
            saved = json.load(f)
    except (OSError, ValueError):
        return s
    if saved.get("profile") in PROFILES:
        s["profile"] = saved["profile"]
    for k in s["custom"]:
        if k in saved.get("custom", {}):
            s["custom"][k] = saved["custom"][k]
    for k in s["tune"]:
        if k in saved.get("tune", {}):
            s["tune"][k] = saved["tune"][k]
    return s


def save_settings(s):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = SETTINGS_FILE + ".new"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1, sort_keys=True)
    os.replace(tmp, SETTINGS_FILE)


def validate(body):
    s = load_settings()
    if body.get("profile") in PROFILES:
        s["profile"] = body["profile"]
    c = body.get("custom") or {}
    for k in ("little_max", "big_max", "gpu_max"):
        if k in c:
            v = c[k]
            s["custom"][k] = int(v) if v not in (None, "") else None
    for k in ("cpu_governor", "gpu_governor"):
        if k in c and re.fullmatch(r"[a-z_]{1,32}", str(c[k])):
            s["custom"][k] = c[k]
    t = body.get("tune") or {}
    if t.get("overclock") in OVERCLOCK:
        s["tune"]["overclock"] = t["overclock"]
    for k in ("cpu_undervolt_mv", "gpu_undervolt_mv"):
        if k in t and int(t[k]) in UNDERVOLT_STEPS:
            s["tune"][k] = int(t[k])
    return s


# --- Monitoring -------------------------------------------------------------

class Monitor:
    """Samples CPU load and battery once a second."""

    def __init__(self):
        self.lock = threading.Lock()
        self.prev = None
        self.load = {}
        self.battery_hist = []

    def run(self):
        while True:
            try:
                self.sample()
            except Exception:  # Keep sampling whatever a file read does.
                log.exception("sample")
            time.sleep(1)

    def sample(self):
        cur = {}
        with open("/proc/stat") as f:
            for line in f:
                m = re.match(r"cpu(\d*) (.*)", line)
                if not m:
                    continue
                v = [int(x) for x in m.group(2).split()]
                idle = v[3] + (v[4] if len(v) > 4 else 0)
                cur[m.group(1) or "all"] = (sum(v), idle)
        load = {}
        if self.prev:
            for k, (tot, idle) in cur.items():
                ptot, pidle = self.prev.get(k, (tot, idle))
                dt = tot - ptot
                load[k] = round(100.0 * (dt - (idle - pidle)) / dt, 1) if dt else 0.0
        self.prev = cur
        with self.lock:
            self.load = load
            bat = battery()
            if bat.get("charge_uah") is not None:
                self.battery_hist.append((time.time(), bat["charge_uah"],
                                          bat.get("voltage_v") or 3.8))
                self.battery_hist = [h for h in self.battery_hist
                                     if h[0] > time.time() - 1800]

    def power_from_history(self):
        """Watts from the change of charge_now over the last 30 minutes."""
        with self.lock:
            h = list(self.battery_hist)
        if len(h) < 2 or h[-1][1] == h[0][1]:
            return None
        # From the first change to the last change of the reading, since
        # the gauge moves in 1% steps.
        changes = [i for i in range(1, len(h)) if h[i][1] != h[i - 1][1]]
        if len(changes) < 2:
            return None
        a, b = h[changes[0]], h[changes[-1]]
        hours = (b[0] - a[0]) / 3600.0
        if hours <= 0:
            return None
        return round((a[1] - b[1]) / 1e6 * (a[2] + b[2]) / 2 / hours, 2)


MONITOR = Monitor()


def battery():
    b = "/sys/class/power_supply/cw2015-battery"
    out = {}
    if os.path.isdir(b):
        out = {
            "capacity": read_int(b + "/capacity"),
            "status": read(b + "/status"),
            "voltage_v": (read_int(b + "/voltage_now") or 0) / 1e6 or None,
            "charge_uah": read_int(b + "/charge_now"),
            "full_uah": read_int(b + "/charge_full"),
            "time_to_empty_min": (read_int(b + "/time_to_empty_now") or 0) // 60
            or None,
        }
    out["ac"] = read_int("/sys/class/power_supply/dc-charger/online") == 1
    for p in sorted(os.listdir("/sys/class/power_supply")):
        if p.startswith("tcpm-source"):
            d = "/sys/class/power_supply/" + p
            if read_int(d + "/online") == 1:
                out["usb_c"] = {
                    "volts": (read_int(d + "/voltage_now") or 0) / 1e6,
                    "max_amps": (read_int(d + "/current_max") or 0) / 1e6,
                }
    return out


def temperatures():
    out = {}
    for z in sorted(os.listdir("/sys/class/thermal")):
        if not z.startswith("thermal_zone"):
            continue
        t = read_int("/sys/class/thermal/%s/temp" % z)
        if t is not None:
            out[read("/sys/class/thermal/%s/type" % z) or z] = round(t / 1000, 1)
    return out


def device_users():
    """Programs that have the GPU or a video codec device open."""
    names = {}
    for v in glob_dir("/sys/class/video4linux"):
        names["/dev/" + v] = read("/sys/class/video4linux/%s/name" % v) or v
    users = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        fd_dir = "/proc/%s/fd" % pid
        try:
            fds = os.listdir(fd_dir)
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(os.path.join(fd_dir, fd))
            except OSError:
                continue
            if target.startswith("/dev/dri/renderD") or target in names:
                comm = read("/proc/%s/comm" % pid) or pid
                users.setdefault(target, set()).add(comm)
    gpu = sorted(set().union(*[u for d, u in users.items()
                               if d.startswith("/dev/dri/renderD")] or [set()]))
    video = [{"device": d, "name": names[d], "users": sorted(users[d])}
             for d in sorted(names) if d in users]
    return {"gpu_users": gpu, "video": video,
            "video_devices": [names[d] for d in sorted(names)]}


def glob_dir(path):
    try:
        return sorted(os.listdir(path))
    except OSError:
        return []


def memory():
    m = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            m[k] = int(v.split()[0]) // 1024
    return {"total_mb": m.get("MemTotal"), "available_mb": m.get("MemAvailable"),
            "swap_total_mb": m.get("SwapTotal"),
            "swap_used_mb": (m.get("SwapTotal", 0) - m.get("SwapFree", 0)),
            "gpu_buffers_mb": m.get("Unevictable")}


def status():
    load = MONITOR.load
    cpu = []
    for p in policies():
        path = p["path"]
        cpu.append({
            "id": p["id"],
            "name": "Cortex-A53" if p["id"] == "little" else "Cortex-A72",
            "cpus": p["cpus"],
            "cur_khz": read_int(path + "/scaling_cur_freq"),
            "max_khz": read_int(path + "/scaling_max_freq"),
            "hw_max_khz": read_int(path + "/cpuinfo_max_freq"),
            "governor": read(path + "/scaling_governor"),
            "load": [load.get(str(c)) for c in p["cpus"]],
        })
    gpu = {}
    if os.path.isdir(GPU_DEVFREQ):
        gpu = {"cur_hz": read_int(GPU_DEVFREQ + "/cur_freq"),
               "max_hz": read_int(GPU_DEVFREQ + "/max_freq"),
               "governor": read(GPU_DEVFREQ + "/governor")}
    bat = battery()
    watts = None
    if bat.get("status") == "Discharging":
        tte = bat.get("time_to_empty_min")
        if tte and bat.get("charge_uah") and bat.get("voltage_v"):
            watts = round(bat["charge_uah"] / 1e6 * bat["voltage_v"] / (tte / 60), 2)
        else:
            watts = MONITOR.power_from_history()
    bat["est_watts"] = watts
    return {
        "time": time.time(),
        "cpu": cpu,
        "cpu_load": load.get("all"),
        "gpu": gpu,
        "temps": temperatures(),
        "battery": bat,
        "memory": memory(),
        "accel": device_users(),
        "uptime_s": int(float((read("/proc/uptime") or "0").split()[0])),
    }


def settings_info():
    s = load_settings()
    pol = {p["id"]: p for p in policies()}
    return {
        "settings": s,
        "applied": profile_limits(s),
        "profiles": PROFILES,
        "little_freqs": avail_freqs(pol["little"]["path"]) if "little" in pol else [],
        "big_freqs": avail_freqs(pol["big"]["path"]) if "big" in pol else [],
        "cpu_governors": (read(pol["big"]["path"] + "/scaling_available_governors")
                          or "").split() if "big" in pol else [],
        "gpu_freqs": gpu_freqs(),
        "gpu_governors": (read(GPU_DEVFREQ + "/available_governors") or "").split(),
        "overclock_levels": {k: {t: [hz // 1000000 for hz, _ in v[t]] for t in v}
                             for k, v in OVERCLOCK.items()},
        "undervolt_steps": UNDERVOLT_STEPS,
        "tune_file": read_tune_file(),
        "running_tables": running_tables(),
        "tune_tables": {k: [(hz // 1000000, v // 1000) for hz, v, _ in rows]
                        for k, rows in tune_tables(s["tune"]).items()},
    }


# --- HTTP -------------------------------------------------------------------

TYPES = {".html": "text/html; charset=utf-8", ".js": "text/javascript",
         ".css": "text/css", ".png": "image/png", ".svg": "image/svg+xml",
         ".webmanifest": "application/manifest+json"}


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "pinebook-control"

    def log_message(self, fmt, *args):
        log.debug(fmt, *args)

    def host_ok(self):
        host = (self.headers.get("Host") or "").lower()
        host = re.sub(r":%d$" % PORT, "", host)
        return host in HOSTS

    def send(self, code, body, ctype="text/plain; charset=utf-8"):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, obj, code=200):
        self.send(code, json.dumps(obj), "application/json")

    def do_GET(self):
        if not self.host_ok():
            return self.send(421, "Use http://pinebook.localhost:%d/\n" % PORT)
        path = self.path.split("?", 1)[0]
        if path == "/api/status":
            return self.send_json(status())
        if path == "/api/settings":
            return self.send_json(settings_info())
        if path == "/":
            path = "/index.html"
        name = os.path.basename(path)
        file = os.path.join(WEB, name)
        if "/" in path[1:] or not os.path.isfile(file):
            return self.send(404, "Not found\n")
        with open(file, "rb") as f:
            self.send(200, f.read(),
                      TYPES.get(os.path.splitext(name)[1], "application/octet-stream"))

    def do_POST(self):
        if not self.host_ok():
            return self.send(421, "Use http://pinebook.localhost:%d/\n" % PORT)
        origin = self.headers.get("Origin")
        if not self.headers.get("X-Pinebook") or (origin and origin not in ORIGINS):
            return self.send(403, "Forbidden\n")
        if self.path != "/api/settings":
            return self.send(404, "Not found\n")
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(min(n, 65536)) or b"{}")
            old = load_settings()
            new = validate(body)
        except (ValueError, TypeError) as e:
            return self.send_json({"error": "bad request: %s" % e}, 400)
        save_settings(new)
        applied = apply_limits(new)
        result = {"applied": applied, "reboot_needed": False}
        if body.get("tune") is not None and new["tune"] != (read_tune_file() or
                                                            DEFAULTS["tune"]):
            try:
                write_tune(new["tune"])
                result["reboot_needed"] = True
            except (OSError, RuntimeError, subprocess.CalledProcessError) as e:
                log.error("Writing %s: %s", TUNE_NAME, e)
                new["tune"] = old["tune"]
                save_settings(new)
                result["error"] = "Could not write %s: %s" % (TUNE_NAME, e)
        self.send_json(result)


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True


class Server6(Server):
    address_family = socket.AF_INET6


def main():
    logging.basicConfig(
        level=logging.INFO, stream=sys.stderr,
        format="pinebook-control: %(levelname)s %(message)s")
    try:
        apply_limits(load_settings())
    except Exception:  # The service is still useful without the limits.
        log.exception("Applying the saved settings")
    threading.Thread(target=MONITOR.run, daemon=True).start()
    servers = [Server(("127.0.0.1", PORT), Handler)]
    try:
        servers.append(Server6(("::1", PORT), Handler))
    except OSError as e:
        log.info("Not listening on [::1]:%d: %s", PORT, e)
    for s in servers[1:]:
        threading.Thread(target=s.serve_forever, daemon=True).start()
    log.info("Listening on http://pinebook.localhost:%d/", PORT)
    servers[0].serve_forever()


if __name__ == "__main__":
    main()
