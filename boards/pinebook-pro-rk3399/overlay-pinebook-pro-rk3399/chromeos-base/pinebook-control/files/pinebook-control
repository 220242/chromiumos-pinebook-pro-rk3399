def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def read_int(path, default=None):
    v = read(path)
    try:
        return int(v)
    except (TypeError, ValueError):
        return default


def write(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(value))
        return True
    except OSError as e:
        log.warning("write %s=%s: %s", path, value, e)
        return False


# --- Hardware -----------------------------------------------------------

def policies():
    """cpufreq policies: little (A53, cpu0-3) first, big (A72, cpu4-5)."""
    out = []
    for name in sorted(os.listdir(CPUFREQ)) if os.path.isdir(CPUFREQ) else []:
        p = os.path.join(CPUFREQ, name)
        cpus = [int(c) for c in (read(p + "/related_cpus") or "").split()]
        if not cpus:
            continue
        out.append({
            "id": "little" if 0 in cpus else "big",
            "path": p,
            "cpus": cpus,
        })
    return out


def avail_freqs(path):
    return sorted(int(x) for x in
                  (read(path + "/scaling_available_frequencies") or "").split())


def gpu_freqs():
    return sorted(int(x) for x in
                  (read(GPU_DEVFREQ + "/available_frequencies") or "").split())


def clamp_to(freqs, want):
    """The highest available frequency not above want (None: the highest)."""
    if not freqs:
        return None
    if want is None:
        return freqs[-1]
    ok = [f for f in freqs if f <= want]
    return ok[-1] if ok else freqs[0]


def profile_limits(settings):
    """Governors and maximum frequencies for the chosen profile."""
    prof = settings.get("profile", "balanced")
    pol = {p["id"]: p for p in policies()}
    lf = avail_freqs(pol["little"]["path"]) if "little" in pol else []
    bf = avail_freqs(pol["big"]["path"]) if "big" in pol else []
    gf = gpu_freqs()
    if prof == "powersave":
        return {"cpu_governor": "schedutil",
                "little_max": clamp_to(lf, 1008000), "big_max": clamp_to(bf, 1200000),
                "gpu_governor": "simple_ondemand", "gpu_max": clamp_to(gf, 400000000)}
    if prof == "performance":
        return {"cpu_governor": "performance",
                "little_max": clamp_to(lf, None), "big_max": clamp_to(bf, None),
                "gpu_governor": "performance", "gpu_max": clamp_to(gf, None)}
    if prof == "custom":
        c = settings.get("custom", {})
        return {"cpu_governor": c.get("cpu_governor") or "schedutil",
                "little_max": clamp_to(lf, c.get("little_max")),
                "big_max": clamp_to(bf, c.get("big_max")),
                "gpu_governor": c.get("gpu_governor") or "simple_ondemand",
                "gpu_max": clamp_to(gf, c.get("gpu_max"))}
    return {"cpu_governor": "schedutil",
            "little_max": clamp_to(lf, None), "big_max": clamp_to(bf, None),
            "gpu_governor": "simple_ondemand", "gpu_max": clamp_to(gf, None)}


def apply_limits(settings):
    lim = profile_limits(settings)
    for p in policies():
        govs = (read(p["path"] + "/scaling_available_governors") or "").split()
        if lim["cpu_governor"] in govs:
            write(p["path"] + "/scaling_governor", lim["cpu_governor"])
        mx = lim["%s_max" % p["id"]]
        if mx:
            write(p["path"] + "/scaling_max_freq", mx)
    if os.path.isdir(GPU_DEVFREQ):
        govs = (read(GPU_DEVFREQ + "/available_governors") or "").split()
        if lim["gpu_governor"] in govs:
            write(GPU_DEVFREQ + "/governor", lim["gpu_governor"])
        if lim["gpu_max"]:
            write(GPU_DEVFREQ + "/max_freq", lim["gpu_max"])
    log.info("Applied %s: %s", settings.get("profile"), lim)
    return lim


# --- Boot-time tuning (EFI-SYSTEM) ---------------------------------------

def tune_tables(tune):
    """The OPP tables a tuning gives: {table: [(Hz, uV, vmax), ...]}."""
    oc = OVERCLOCK.get(tune.get("overclock"), {})
    out = {}
    for name, t in STOCK.items():
        off = 1000 * int(tune.get("gpu_undervolt_mv" if name == "gpu"
                                  else "cpu_undervolt_mv") or 0)
        rows = []
        for hz, uv in t["opps"] + oc.get(name, []):
            v = max(uv - off, VMIN)
            rows.append((hz, v, max(t["vmax"], v)))
        out[name] = rows
    return out


def tune_script(tune):
    lines = ["# %s %s" % (TUNE_NAME, json.dumps(tune, sort_keys=True)),
             'echo "pinebook-tune: overclock %s, CPU -%s mV, GPU -%s mV"' % (
                 tune.get("overclock"), tune.get("cpu_undervolt_mv"),
                 tune.get("gpu_undervolt_mv"))]
    for name, rows in tune_tables(tune).items():
        node = STOCK[name]["node"]
        nstock = len(STOCK[name]["opps"])
        for i, (hz, v, vmax) in enumerate(rows):
            path = "%s/opp%02d" % (node, i)
            if i >= nstock:
                lines.append("fdt mknode %s opp%02d" % (node, i))
                lines.append("fdt set %s opp-hz <0x%x 0x%x>" % (
                    path, hz >> 32, hz & 0xffffffff))
            elif v == STOCK[name]["opps"][i][1]:
                continue
            lines.append("fdt set %s opp-microvolt <0x%x 0x%x 0x%x>" % (
                path, v, v, vmax))
    return "\n".join(lines) + "\n"


def uimage_script(text):
    """A U-Boot legacy script image, as `mkimage -T script` makes."""
    data = text.encode()
    payload = struct.pack(">II", len(data), 0) + data
    hdr = struct.pack(">IIIIIIIBBBB32s", 0x27051956, 0, int(time.time()),
                      len(payload), 0, 0, zlib.crc32(payload) & 0xffffffff,
                      5, 22, 6, 0, b"pinebook-tune")  # linux, arm64, script
    hcrc = zlib.crc32(hdr) & 0xffffffff
    return hdr[:4] + struct.pack(">I", hcrc) + hdr[8:] + payload


def boot_disk():
    try:
        dev = subprocess.run(["rootdev", "-s", "-d"], capture_output=True,
                             text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None
    return dev or None


def esp_device():
    disk = boot_disk()
    if not disk:
        return None
    sep = "p" if disk[-1].isdigit() else ""
    dev = "%s%s%d" % (disk, sep, ESP_PART)
    return dev if os.path.exists(dev) else None


class EspMount:
    """EFI-SYSTEM, mounted for the duration of a with block."""

    def __enter__(self):
        self.dev = esp_device()
        if not self.dev:
            raise RuntimeError("EFI-SYSTEM partition not found")
        os.makedirs(RUN, exist_ok=True)
        self.dir = tempfile.mkdtemp(dir=RUN, prefix="esp.")
        subprocess.run(["mount", "-t", "vfat", "-o",
                        "nosuid,nodev,noexec,umask=0022", self.dev, self.dir],
                       check=True, capture_output=True)
        return self.dir

    def __exit__(self, *exc):
        subprocess.run(["umount", self.dir], capture_output=True)
        os.rmdir(self.dir)


def tune_is_stock(tune):
    return (tune.get("overclock", "off") == "off"
            and not tune.get("cpu_undervolt_mv")
            and not tune.get("gpu_undervolt_mv"))


def write_tune(tune):
    with EspMount() as esp:
        path = os.path.join(esp, TUNE_NAME)
        if tune_is_stock(tune):
            if os.path.exists(path):
                os.remove(path)
            log.info("Removed %s", TUNE_NAME)
        else:
            tmp = path + ".new"
            with open(tmp, "wb") as f:
                f.write(uimage_script(tune_script(tune)))
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, path)
            log.info("Wrote %s: %s", TUNE_NAME, tune)
        subprocess.run(["sync"])


def read_tune_file():
    """The tuning saved on EFI-SYSTEM (None: none, stock tables)."""
    try:
        with EspMount() as esp:
            with open(os.path.join(esp, TUNE_NAME), "rb") as f:
                data = f.read()
    except (OSError, RuntimeError, subprocess.CalledProcessError):
        return None
    m = re.search(rb"# %s (\{[^\n]*\})" % TUNE_NAME.encode(), data)
    try:
        return json.loads(m.group(1)) if m else {"unknown": True}
    except ValueError:
        return {"unknown": True}


