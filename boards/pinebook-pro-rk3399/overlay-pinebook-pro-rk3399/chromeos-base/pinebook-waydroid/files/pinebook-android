class RecentHandler(logging.Handler):
    """Keeps the latest log lines for the page's log view."""

    def emit(self, record):
        recent.append(self.format(record))


def setup_logging(to_file):
    fmt = logging.Formatter("%(asctime)s %(message)s", "%Y-%m-%d %H:%M:%S")
    handlers = [logging.StreamHandler(sys.stderr), RecentHandler()]
    if to_file:
        for path in (LOG_FILE, RUN_LOG_FILE):
            try:
                handlers.append(logging.handlers.RotatingFileHandler(
                    path, maxBytes=1 << 20, backupCount=1))
            except OSError as e:
                print(f"pinebook-android: no log file {path}: {e}", file=sys.stderr)
    for h in handlers:
        h.setFormatter(fmt)
        log.addHandler(h)
    log.setLevel(logging.INFO)


class Failure(Exception):
    """An error to show on the page: an id the page translates, and details."""

    def __init__(self, code, detail=""):
        super().__init__(f"{code}: {detail}" if detail else code)
        self.code = code
        self.detail = detail


