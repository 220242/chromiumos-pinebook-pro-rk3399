# Disks and the GPT

def read_file(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def stateful_device():
    """The block device mounted at /mnt/stateful_partition, e.g. mmcblk1p1."""
    with open("/proc/self/mountinfo") as f:
        for line in f:
            fields = line.split()
            if len(fields) > 9 and fields[4] == STATEFUL:
                source = fields[fields.index("-") + 2]
                if source.startswith("/dev/"):
                    return os.path.basename(os.path.realpath(source))
    raise Failure("no_disk", f"nothing is mounted at {STATEFUL}")


def boot_disk():
    """The disk the system runs from, e.g. mmcblk1, refusing the eMMC."""
    part = stateful_device()
    sys_part = os.path.realpath(f"/sys/class/block/{part}")
    if not os.path.exists(sys_part + "/partition"):
        raise Failure("no_disk", f"{part} is not a partition")
    disk = os.path.basename(os.path.dirname(sys_part))
    # The Pinebook Pro's eMMC (MMC, not SD) holds the owner's other system.
    if read_file(f"/sys/block/{disk}/device/type") == "MMC":
        raise Failure("emmc", f"/dev/{disk} is the eMMC")
    return disk


def disk_partitions(disk):
    """{number: name} of the partitions the kernel knows on disk."""
    parts = {}
    for path in glob.glob(f"/sys/class/block/{disk}/*/partition"):
        parts[int(read_file(path))] = os.path.basename(os.path.dirname(path))
    return parts


GPT_HEADER = struct.Struct("<8s4sII4xQQQQ16sQIII")
GPT_ENTRY = struct.Struct("<16s16sQQQ72s")


class GptError(Exception):
    pass


def crc32(data):
    return zlib.crc32(data) & 0xFFFFFFFF


def pread(fd, size, offset):
    data = os.pread(fd, size, offset)
    if len(data) != size:
        raise GptError(f"short read at byte {offset}")
    return data


def pwrite(fd, data, offset):
    if os.pwrite(fd, data, offset) != len(data):
        raise GptError(f"short write at byte {offset}")


class Gpt:
    """The primary GPT of a disk or disk image, checked against its CRCs."""

    def __init__(self, fd, sectors, sector_size=512):
        self.fd = fd
        self.sectors = sectors
        self.ss = sector_size
        raw = pread(fd, sector_size, sector_size)
        (sig, self.revision, self.header_size, header_crc, self.my_lba,
         self.alternate_lba, self.first_usable, self.last_usable,
         self.disk_guid, self.entries_lba, self.num_entries, self.entry_size,
         entries_crc) = GPT_HEADER.unpack_from(raw)
        if sig != b"EFI PART":
            raise GptError("no GPT on the disk")
        if not GPT_HEADER.size <= self.header_size <= sector_size:
            raise GptError(f"odd GPT header size {self.header_size}")
        check = bytearray(raw[:self.header_size])
        check[16:20] = bytes(4)
        if crc32(check) != header_crc or self.my_lba != 1:
            raise GptError("the primary GPT header is damaged")
        if self.entry_size < GPT_ENTRY.size or self.entry_size % 8:
            raise GptError(f"odd GPT entry size {self.entry_size}")
        self.header_raw = raw
        self.entries = bytearray(pread(
            fd, self.num_entries * self.entry_size, self.entries_lba * sector_size))
        if crc32(self.entries) != entries_crc:
            raise GptError("the GPT partition entries are damaged")
        self.entry_sectors = -(-len(self.entries) // sector_size)
        if not (self.entries_lba + self.entry_sectors <= self.first_usable
                and self.alternate_lba < sectors):
            raise GptError("the GPT does not fit the disk")

    def entry(self, index):
        start = index * self.entry_size
        ptype, puuid, first, last, attrs, name = GPT_ENTRY.unpack_from(
            self.entries, start)
        return {
            "number": index + 1,
            "type": uuid.UUID(bytes_le=ptype),
            "uuid": uuid.UUID(bytes_le=puuid),
            "first": first,
            "last": last,
            "name": name.decode("utf-16-le", "replace").split("\0")[0],
            "used": ptype != bytes(16),
        }

    def used(self):
        return [e for e in map(self.entry, range(self.num_entries)) if e["used"]]

    def find(self, name):
        for e in self.used():
            if e["name"] == name:
                return e
        return None

    def plan(self):
        """Where a partition filling the free end of the disk would go."""
        used = self.used()
        free_slots = [i for i in range(FIRST_FREE_SLOT, self.num_entries)
                      if not self.entry(i)["used"]]
        if not free_slots:
            raise GptError("no free slot in the GPT")
        align = max(ALIGN // self.ss, 1)
        parts_end = max([e["last"] for e in used] + [self.first_usable - 1])
        # A ChromiumOS image written to a bigger card keeps its backup GPT at
        # the end of the image. Start after it: writing an image of the same
        # size to the card again then leaves this partition (and Android's
        # data) alone, and setup finds it again.
        end = parts_end
        if self.alternate_lba < self.sectors - 1:
            end = max(end, self.alternate_lba)
        backup_lba = self.sectors - 1
        backup_entries_lba = backup_lba - self.entry_sectors
        last_usable = backup_entries_lba - 1
        first = -(-(end + 1) // align) * align
        last = (last_usable + 1) // align * align - 1
        return {
            "index": free_slots[0],
            "number": free_slots[0] + 1,
            "first": first,
            "last": last,
            "bytes": max(last - first + 1, 0) * self.ss,
            "parts_end": parts_end,
            "used_end": end,
            "backup_lba": backup_lba,
            "backup_entries_lba": backup_entries_lba,
            "last_usable": last_usable,
        }

    def _header(self, my_lba, alternate_lba, last_usable, entries_lba, entries_crc):
        raw = bytearray(self.header_raw)
        GPT_HEADER.pack_into(
            raw, 0, b"EFI PART", self.revision, self.header_size, 0, my_lba,
            alternate_lba, self.first_usable, last_usable, self.disk_guid,
            entries_lba, self.num_entries, self.entry_size, entries_crc)
        struct.pack_into("<I", raw, 16, crc32(raw[:self.header_size]))
        return bytes(raw)

    def add(self, plan, name, part_uuid=None):
        """Writes the new entry and moves the backup GPT to the end of the disk."""
        if plan["last"] < plan["first"]:
            raise GptError("no free space at the end of the disk")
        if plan["first"] <= plan["used_end"] or plan["last"] >= plan["backup_entries_lba"]:
            raise GptError("the new partition would overlap")
        old_backup = self.alternate_lba
        if old_backup > plan["backup_lba"]:
            raise GptError("the backup GPT is beyond the end of the disk")
        entry = GPT_ENTRY.pack(
            PART_TYPE.bytes_le, (part_uuid or uuid.uuid4()).bytes_le,
            plan["first"], plan["last"], 0,
            name.encode("utf-16-le")[:72].ljust(72, b"\0"))
        start = plan["index"] * self.entry_size
        self.entries[start:start + len(entry)] = entry
        entries_crc = crc32(self.entries)
        ss = self.ss
        # The backup goes first, into space nothing uses yet: until the
        # primary is rewritten the disk still describes the old layout, and a
        # torn primary write leaves a valid backup at the end of the disk,
        # where readers look for it.
        pwrite(self.fd, bytes(self.entries), plan["backup_entries_lba"] * ss)
        pwrite(self.fd, self._header(plan["backup_lba"], 1, plan["last_usable"],
                                     plan["backup_entries_lba"], entries_crc),
               plan["backup_lba"] * ss)
        os.fsync(self.fd)
        pwrite(self.fd, bytes(self.entries), self.entries_lba * ss)
        pwrite(self.fd, self._header(1, plan["backup_lba"], plan["last_usable"],
                                     self.entries_lba, entries_crc), ss)
        os.fsync(self.fd)
        # A protective MBR (one 0xEE entry and nothing else) covers the disk.
        mbr = bytearray(pread(self.fd, 512, 0))
        if (mbr[510:512] == b"\x55\xaa" and mbr[446 + 4] == 0xEE
                and mbr[462:510] == bytes(48)):
            struct.pack_into("<I", mbr, 446 + 12, min(self.sectors - 1, 0xFFFFFFFF))
            pwrite(self.fd, bytes(mbr), 0)
        # The image's old backup header now sits before the new partition.
        if plan["parts_end"] < old_backup < plan["first"]:
            pwrite(self.fd, bytes(ss), old_backup * ss)
        os.fsync(self.fd)
        self.alternate_lba = plan["backup_lba"]
        self.last_usable = plan["last_usable"]
        self.header_raw = pread(self.fd, ss, ss)


class BlkpgPartition(ctypes.Structure):
    _fields_ = [("start", ctypes.c_longlong), ("length", ctypes.c_longlong),
                ("pno", ctypes.c_int), ("devname", ctypes.c_char * 64),
                ("volname", ctypes.c_char * 64)]


class BlkpgIoctlArg(ctypes.Structure):
    _fields_ = [("op", ctypes.c_int), ("flags", ctypes.c_int),
                ("datalen", ctypes.c_int), ("data", ctypes.c_void_p)]


BLKPG = 0x1269
BLKPG_ADD_PARTITION = 1


def kernel_add_partition(fd, number, first, last, ss):
    """Tells the kernel about a new partition on a disk that is in use."""
    part = BlkpgPartition(start=first * ss, length=(last - first + 1) * ss,
                          pno=number)
    arg = BlkpgIoctlArg(op=BLKPG_ADD_PARTITION, datalen=ctypes.sizeof(part),
                        data=ctypes.addressof(part))
    fcntl.ioctl(fd, BLKPG, arg)


def ext4_label(device_path, offset=0):
    """The label of an ext2/3/4 file system at offset, or None."""
    try:
        with open(device_path, "rb") as f:
            f.seek(offset + 1024)
            sb = f.read(136)
    except OSError:
        return None
    if len(sb) < 136 or struct.unpack_from("<H", sb, 56)[0] != 0xEF53:
        return None
    return sb[120:136].split(b"\0")[0].decode("utf-8", "replace")


def run(cmd, check=True, timeout=None, **kw):
    log.info("$ %s", " ".join(cmd))
    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       text=True, timeout=timeout, **kw)
    out = p.stdout.strip()
    if out:
        for line in out.splitlines()[-30:]:
            log.info("  %s", line)
    if check and p.returncode != 0:
        raise Failure("command_failed",
                      f"{' '.join(cmd)} exited with {p.returncode}: {out[-500:]}")
    return p


def open_gpt(disk, write=False):
    """(fd, Gpt, sector size) of a disk; the caller closes fd."""
    # /sys/block/*/size counts 512-byte sectors whatever the sector size.
    ss = int(read_file(f"/sys/block/{disk}/queue/logical_block_size", "512"))
    sectors = int(read_file(f"/sys/block/{disk}/size")) * 512 // ss
    fd = os.open(f"/dev/{disk}", (os.O_RDWR if write else os.O_RDONLY) | os.O_CLOEXEC)
    try:
        return fd, Gpt(fd, sectors, ss), ss
    except BaseException:
        os.close(fd)
        raise


def partition_info():
    """What the setup page shows: the card, and the space Android would get."""
    info = {"disk": None, "card": None, "free_bytes": 0, "min_free": MIN_FREE,
            "has_partition": False, "has_data": False}
    try:
        disk = boot_disk()
        info["disk"] = disk
        info["card"] = read_file(f"/sys/block/{disk}/device/type") == "SD"
        fd, gpt, ss = open_gpt(disk)
        try:
            if gpt.find(PART_LABEL):
                info["has_partition"] = True
            else:
                plan = gpt.plan()
                info["free_bytes"] = plan["bytes"]
                # Android's file system from before the card was reflashed
                # with the same image layout: setup finds it again.
                info["has_data"] = ext4_label(f"/dev/{disk}", plan["first"] * ss) == PART_LABEL
        finally:
            os.close(fd)
    except Failure as e:
        info["error"] = {"code": e.code, "detail": e.detail}
    except GptError as e:
        info["error"] = {"code": "gpt", "detail": str(e)}
    except (OSError, ValueError) as e:
        info["error"] = {"code": "no_disk", "detail": str(e)}
    return info


def data_partition(step=None, create=False):
    """The /dev path of ANDROID-DATA on the boot disk, or None if there is
    none and create is False. Adds it to the GPT if asked, and tells the
    kernel about it if it is not in the kernel's partition table yet (until
    the next boot, a partition added while the disk is in use is not)."""
    disk = boot_disk()
    try:
        fd, gpt, ss = open_gpt(disk, write=create)
    except GptError as e:
        raise Failure("gpt", str(e))
    except (OSError, ValueError) as e:
        raise Failure("no_disk", f"/dev/{disk}: {e}")
    try:
        entry = gpt.find(PART_LABEL)
        if entry is None:
            if not create:
                return None
            plan = gpt.plan()
            if plan["bytes"] < MIN_FREE:
                raise Failure("no_space", f"{plan['bytes'] / 1e9:.1f} GB free on /dev/{disk}")
            step("partition")
            log.info("Adding partition %d (%s) on /dev/%s: sectors %d-%d, %.1f GB",
                     plan["number"], PART_LABEL, disk, plan["first"], plan["last"],
                     plan["bytes"] / 1e9)
            gpt.add(plan, PART_LABEL)
            Gpt(fd, gpt.sectors, ss)  # re-read: the CRCs must check out
            entry = gpt.find(PART_LABEL)
        if entry["number"] not in disk_partitions(disk):
            log.info("Adding partition %d to the kernel's table of /dev/%s",
                     entry["number"], disk)
            kernel_add_partition(fd, entry["number"], entry["first"], entry["last"], ss)
    except GptError as e:
        raise Failure("gpt", str(e))
    except OSError as e:
        raise Failure("gpt", f"/dev/{disk}: {e}")
    finally:
        os.close(fd)
    for _ in range(50):
        name = disk_partitions(disk).get(entry["number"])
        if name and os.path.exists("/dev/" + name):
            return "/dev/" + name
        time.sleep(0.1)
    raise Failure("gpt", f"partition {entry['number']} of /dev/{disk} did not appear")


def create_data_partition(step):
    dev = data_partition(step, create=True)
    if ext4_label(dev) == PART_LABEL:
        log.info("%s already holds the %s file system; keeping it", dev, PART_LABEL)
    else:
        step("format")
        run(["mkfs.ext4", "-F", "-q", "-L", PART_LABEL, "-m", "0",
             "-E", "lazy_itable_init=1,lazy_journal_init=1", dev], timeout=600)
    return dev


def is_mounted(path):
    with open("/proc/self/mountinfo") as f:
        return any(line.split()[4] == path for line in f)


def mount_data():
    """Mounts ANDROID-DATA at /var/lib/waydroid. False if there is none
    (or it was never formatted)."""
    if is_mounted(WORK):
        return True
    dev = data_partition()
    if not dev or ext4_label(dev) != PART_LABEL:
        return False
    os.makedirs(WORK, 0o755, exist_ok=True)
    if shutil.which("e2fsck"):
        p = run(["e2fsck", "-p", dev], check=False, timeout=600)
        if p.returncode >= 4:
            raise Failure("fsck", f"e2fsck {dev} exited with {p.returncode}")
    # A mount of its own: exec and symlinks work here, unlike on /var.
    run(["mount", "-t", "ext4", "-o", "noatime", dev, WORK])
    return True


