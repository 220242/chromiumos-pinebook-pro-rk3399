def chronos():
    return pwd.getpwnam(USER)


def session_env():
    return {
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
        "HOME": USER_HOME,
        "LANG": "C.UTF-8",
        "PYTHONUNBUFFERED": "1",
        "XDG_DATA_HOME": XDG_DATA_HOME,
        "XDG_RUNTIME_DIR": WAYLAND_DIR,
        "WAYLAND_DISPLAY": WAYLAND_DISPLAY,
        # ChromiumOS has no PulseAudio; Waydroid binds this file regardless.
        "PULSE_RUNTIME_PATH": PULSE_DIR,
        "DBUS_SESSION_BUS_ADDRESS": "unix:path=" + SESSION_BUS,
    }


def root_env():
    return {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "HOME": "/root",
            "LANG": "C.UTF-8", "PYTHONUNBUFFERED": "1"}


def as_user(**kw):
    pw = chronos()
    if sys.version_info >= (3, 9):
        ids = dict(user=pw.pw_uid, group=pw.pw_gid, extra_groups=[])
    else:
        # Python 3.8's Popen has no user/group arguments.
        def drop_root():
            os.setgroups([])
            os.setgid(pw.pw_gid)
            os.setuid(pw.pw_uid)
        ids = dict(preexec_fn=drop_root)
    return dict(env=session_env(), cwd=USER_HOME, **ids, **kw)


def run_user(cmd, timeout=120, check=True):
    return run(cmd, check=check, timeout=timeout, **as_user())


def waydroid_cfg():
    cfg = configparser.ConfigParser()
    cfg.read(WORK + "/waydroid.cfg")
    return cfg


def is_initialized():
    """Whether `waydroid init` has both images. It records an image's date
    once the whole image is in place, and resets it when it switches to
    another one (adding Google Play), so a half-done download does not
    count."""
    cfg = waydroid_cfg()
    return (os.path.isdir(WORK + "/rootfs")
            and all(os.path.isfile(f"{WORK}/images/{i}.img")
                    and cfg.get("waydroid", f"{i}_datetime", fallback="0") != "0"
                    for i in ("system", "vendor")))


def has_google_play():
    """Whether the Android image is Waydroid's GAPPS one (Google Play)."""
    return "/GAPPS." in waydroid_cfg().get("waydroid", "system_ota", fallback="")


GSF_DB = "/data/data/com.google.android.gsf/databases/gservices.db"


def android_id():
    """The ID Google asks for to let Play run on a device it has not
    certified (https://www.google.com/android/uncertified)."""
    p = run([WAYDROID, "shell", "--", "sqlite3", GSF_DB,
             "select value from main where name = 'android_id';"],
            check=False, timeout=60, env=root_env(), cwd="/")
    value = (p.stdout or "").strip().splitlines()
    if p.returncode != 0 or not value or not value[-1].isdigit():
        raise Failure("no_android_id", (p.stdout or "").strip()[-300:])
    return value[-1]


def gpu_render_node():
    """The Panfrost (Mali-T860) render node; other render nodes, such as
    ChromeOS's vgem, cannot run Android's graphics."""
    for path in sorted(glob.glob("/sys/class/drm/renderD*")):
        if "DRIVER=panfrost" in read_file(path + "/device/uevent").splitlines():
            return "/dev/dri/" + os.path.basename(path)
    return None


def waydroid_configs():
    """A hash of the installed Waydroid's container config templates."""
    digest = hashlib.sha256()
    for path in sorted(glob.glob(WAYDROID_CONFIGS + "/*")):
        with open(path, "rb") as f:
            digest.update(path.encode() + b"\0" + f.read())
    return digest.hexdigest()


def configure_waydroid():
    """Board settings on top of `waydroid init`; regenerates the container
    config when they change, or when the card has a newer image whose
    Waydroid brings other container configs."""
    path = WORK + "/waydroid.cfg"
    cfg = configparser.ConfigParser()
    cfg.read(path)
    configs = waydroid_configs()
    changed = read_file(CONFIGS_STAMP) != configs
    node = gpu_render_node()
    if node and cfg["waydroid"].get("drm_device") != node:
        cfg["waydroid"]["drm_device"] = node
        changed = True
    if "properties" not in cfg:
        cfg["properties"] = {}
    # Mesa has no Vulkan driver for the Mali-T860 (Midgard); without this
    # Waydroid would point Android at panvk.
    if cfg["properties"].get("ro.hardware.vulkan") != "none":
        cfg["properties"]["ro.hardware.vulkan"] = "none"
        changed = True
    if changed:
        with open(path + ".new", "w") as f:
            cfg.write(f)
        os.replace(path + ".new", path)
        run([WAYDROID, "upgrade", "--offline"], timeout=300, env=root_env())
        write_file(CONFIGS_STAMP, configs)


def read_desktop_file(path):
    entry = {}
    section = None
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if line.startswith("["):
                section = line
            elif section == "[Desktop Entry]" and "=" in line:
                key, value = line.split("=", 1)
                entry.setdefault(key.strip(), value.strip())
    return entry


PACKAGE_RE = re.compile(r"^[A-Za-z0-9_]+(\.[A-Za-z0-9_]+)+$")


def list_apps():
    apps = []
    for path in glob.glob(APPS_DIR + "/waydroid.*.desktop"):
        package = os.path.basename(path)[len("waydroid."):-len(".desktop")]
        if not PACKAGE_RE.match(package):
            continue
        try:
            entry = read_desktop_file(path)
        except OSError:
            continue
        apps.append({
            "package": package,
            "name": entry.get("Name", package),
            "system": entry.get("NoDisplay", "").lower() == "true",
            "icon": os.path.isfile(f"{ICONS_DIR}/{package}.png"),
        })
    return sorted(apps, key=lambda a: (a["system"], a["name"].lower()))


def app_files():
    """When each app's .desktop file last changed. Waydroid writes an app's
    file when Android installs or updates the app, and every app's file when
    Android starts."""
    files = {}
    for path in glob.glob(APPS_DIR + "/waydroid.*.desktop"):
        try:
            files[path] = os.stat(path).st_mtime_ns
        except OSError:
            pass
    return files


def tail(path, lines=200):
    try:
        with open(path, errors="replace") as f:
            return f.readlines()[-lines:]
    except OSError:
        return []


def write_file(path, data, mode=0o644):
    with open(path + ".new", "w") as f:
        f.write(data)
    os.chmod(path + ".new", mode)
    os.replace(path + ".new", path)


class Android:
    """Waydroid's processes and the state the page shows."""

    def __init__(self):
        self.lock = threading.RLock()
        self.busy = None        # "setup", "start", "stop" or "install"
        self.step = None        # what the busy operation is doing now
        self.progress = None    # [done, total] bytes of a download
        self.error = None       # {"code", "detail"} of the last failure
        self.notice = None      # {"code", "detail"} of the last success
        self.container = None   # `waydroid container start` (root)
        self.bus = None         # the session's dbus-daemon (chronos)
        self.session = None     # `waydroid session start` (chronos)
        self.ready = threading.Event()
        self.session_output = collections.deque(maxlen=60)
        self.stopping = False

    # -- state ------------------------------------------------------------

    def running(self):
        """Whether Android is up, whatever operation runs."""
        session = self.session
        return bool(session and session.poll() is None and self.ready.is_set())

    def state(self):
        with self.lock:
            busy = self.busy
        if busy in ("setup", "start", "stop"):
            return {"setup": "setting_up", "start": "starting", "stop": "stopping"}[busy]
        if not is_mounted(WORK) or not is_initialized():
            return "needs_setup"
        if self.running():
            return "running"
        if busy or (self.session and self.session.poll() is None):
            # Starting, also for an install while Android was stopped.
            return "starting"
        return "stopped"

    def status(self):
        state = self.state()
        with self.lock:
            out = {
                "state": state,
                "busy": self.busy,
                "step": self.step,
                "progress": self.progress,
                "error": self.error,
                "notice": self.notice,
                "checks": checks(),
            }
        if state == "needs_setup" and not self.busy:
            out["setup"] = partition_info()
        if state in ("running", "stopped"):
            out["apps"] = list_apps()
            out["google_play"] = has_google_play()
        return out

    def set_step(self, step, progress=None):
        with self.lock:
            self.step = step
            self.progress = progress
        if progress is None:
            log.info("== %s", step)

    def begin(self, name):
        with self.lock:
            if self.busy:
                raise Failure("busy", self.busy)
            self.busy = name
            self.step = None
            self.progress = None
            self.error = None
            self.notice = None

    def end(self, error=None, notice=None):
        with self.lock:
            self.busy = None
            self.step = None
            self.progress = None
            self.error = error
            self.notice = notice

    def background(self, name, func, *args):
        """Runs func in a thread as operation name; errors go to the page."""
        self.begin(name)

        def body():
            try:
                notice = func(*args)
                self.end(notice=notice)
            except Failure as e:
                log.error("%s failed: %s", name, e)
                self.end(error={"code": e.code, "detail": e.detail})
            except Exception as e:  # pylint: disable=broad-except
                log.exception("%s failed", name)
                self.end(error={"code": "internal", "detail": repr(e)})

        threading.Thread(target=body, name=name, daemon=True).start()

    # -- setup ------------------------------------------------------------

    def do_setup(self, then_start, google_play=False):
        missing = [c for c, ok in checks().items() if not ok and c != "wayland"]
        if missing:
            raise Failure("unsupported", ", ".join(missing))
        # Setting up again (to add Google Play) replaces the system image;
        # apps and their data stay.
        if self.session and self.session.poll() is None:
            self.set_step("stop")
            self.do_stop()
        if not mount_data():
            create_data_partition(self.set_step)
            if not mount_data():
                raise Failure("gpt", "ANDROID-DATA is missing after creating it")
        self.prepare_dirs()
        # Setting up again never takes Google Play away, and a card written
        # again with an image of the same size has Android complete already.
        google_play = google_play or (is_initialized() and has_google_play())
        if not is_initialized() or google_play != has_google_play():
            self.set_step("download")
            self.waydroid_init("GAPPS" if google_play else "VANILLA")
        self.set_step("configure")
        configure_waydroid()
        log.info("Android is set up")
        if then_start:
            self.do_start(show=True)
        return {"code": "setup_done"}

    def waydroid_init(self, system_type):
        # -f: also when set up before. Parts already downloaded with the same
        # system type are kept, so a retry continues where it stopped.
        cmd = [WAYDROID, "init", "-f", "-s", system_type]
        log.info("$ %s", " ".join(cmd))
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             env=root_env(), cwd="/")
        last = collections.deque(maxlen=20)
        part = "system"
        buf = b""
        while True:
            chunk = p.stdout.read1(4096)
            if not chunk:
                break
            buf += chunk
            # Progress lines end in \r, the others in \n.
            *lines, buf = re.split(rb"[\r\n]", buf)
            for raw in lines:
                line = raw.decode("utf-8", "replace").strip()
                if not line:
                    continue
                m = PROGRESS_RE.search(line)
                if m:
                    done, total = (int(float(x) * 1e6) for x in m.groups())
                    self.set_step("download_" + part, [done, total])
                    continue
                last.append(line)
                log.info("  %s", line)
                if "Downloading " in line:
                    # The system image comes first, then the vendor image
                    # (.../images/vendor/...-vendor.zip); a retry skips
                    # the parts already installed.
                    part = "vendor" if "vendor" in line else "system"
                    self.set_step("download_" + part, [0, 0])
                elif "Validating" in line:
                    self.set_step("verify_" + part)
                elif "Extracting" in line:
                    self.set_step("extract_" + part)
        if p.wait() != 0 or not is_initialized():
            detail = "\n".join(list(last)[-5:])
            if "OTA channel" in detail or "URLError" in detail or "Name or service" in detail:
                raise Failure("no_network", detail)
            raise Failure("init_failed", detail)

    def prepare_dirs(self):
        pw = chronos()
        for path in (USER_HOME, XDG_DATA_HOME, INCOMING):
            os.makedirs(path, 0o755, exist_ok=True)
            os.chown(path, pw.pw_uid, pw.pw_gid)
        os.makedirs(RUN, 0o755, exist_ok=True)
        for path, mode in ((SESSION_BUS_DIR, 0o700), (PULSE_DIR, 0o755)):
            os.makedirs(path, mode, exist_ok=True)
            os.chown(path, pw.pw_uid, pw.pw_gid)
        # Waydroid bind-mounts $PULSE_RUNTIME_PATH/native into Android
        # unconditionally; an empty file keeps the container starting.
        native = PULSE_DIR + "/native"
        if not os.path.exists(native):
            open(native, "w").close()
        os.chown(native, pw.pw_uid, pw.pw_gid)

    # -- start ------------------------------------------------------------

    def do_start(self, show=True, package=None):
        if not is_mounted(WORK) and not mount_data():
            raise Failure("not_set_up")
        if not is_initialized():
            raise Failure("not_set_up")
        if not os.path.exists(f"{WAYLAND_DIR}/{WAYLAND_DISPLAY}"):
            raise Failure("no_wayland", f"{WAYLAND_DIR}/{WAYLAND_DISPLAY} is missing")
        if not (self.session and self.session.poll() is None):
            self.set_step("configure")
            self.prepare_dirs()
            configure_waydroid()
            self.set_step("container")
            self.start_container_service()
            self.start_session_bus()
            self.set_step("boot")
            self.start_session()
        if not self.ready.wait(timeout=900):
            raise Failure("boot_timeout", "\n".join(self.session_output))
        if self.session.poll() is not None:
            raise Failure("session_failed", "\n".join(self.session_output))
        if package:
            self.set_step("show")
            run_user([WAYDROID, "app", "launch", package], timeout=60)
        elif show:
            self.set_step("show")
            run_user([WAYDROID, "show-full-ui"], timeout=60)
        return None

    def start_container_service(self):
        if self.container and self.container.poll() is None:
            return
        import dbus  # pylint: disable=import-outside-toplevel
        bus = dbus.SystemBus()
        if bus.name_has_owner("id.waydro.Container"):
            # Left over from an earlier run of this service; it works as well.
            log.info("Waydroid's container service is already running")
            return
        log.info("$ %s container start", WAYDROID)
        self.container = subprocess.Popen(
            [WAYDROID, "container", "start"], stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, env=root_env(), cwd="/")
        threading.Thread(target=self.pipe_to_log, args=(self.container, "container"),
                         daemon=True).start()
        for _ in range(300):
            if bus.name_has_owner("id.waydro.Container"):
                return
            if self.container.poll() is not None:
                break
            time.sleep(0.1)
        raise Failure("container_failed", "\n".join(list(recent)[-10:]))

    def start_session_bus(self):
        if self.bus and self.bus.poll() is None and os.path.exists(SESSION_BUS):
            return
        kill_pidfile(SESSION_BUS_PID, "dbus-daemon")
        if os.path.exists(SESSION_BUS):
            os.unlink(SESSION_BUS)
        cmd = ["dbus-daemon", "--nofork", "--nopidfile",
               f"--config-file={SHARE}/session-bus.conf",
               f"--address=unix:path={SESSION_BUS}"]
        log.info("$ %s", " ".join(cmd))
        self.bus = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, **as_user())
        threading.Thread(target=self.pipe_to_log, args=(self.bus, "dbus"),
                         daemon=True).start()
        write_file(SESSION_BUS_PID, str(self.bus.pid))
        for _ in range(100):
            if os.path.exists(SESSION_BUS):
                return
            if self.bus.poll() is not None:
                break
            time.sleep(0.05)
        raise Failure("bus_failed", f"dbus-daemon exited with {self.bus.poll()}")

    def start_session(self):
        self.ready.clear()
        self.session_output.clear()
        cmd = [WAYDROID, "session", "start"]
        log.info("$ %s (as %s)", " ".join(cmd), USER)
        self.session = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                        stderr=subprocess.STDOUT, **as_user())
        threading.Thread(target=self.watch_session, args=(self.session,),
                         daemon=True).start()

    def watch_session(self, proc):
        for raw in proc.stdout:
            line = raw.decode("utf-8", "replace").rstrip()
            self.session_output.append(line)
            log.info("[session] %s", line)
            if READY_RE.search(line):
                self.ready.set()
        code = proc.wait()
        log.info("Android session ended (exit status %s)", code)
        # Wake anyone waiting for the boot; they see the session is gone.
        self.ready.set()

    def pipe_to_log(self, proc, name):
        for raw in proc.stdout:
            log.info("[%s] %s", name, raw.decode("utf-8", "replace").rstrip())
        log.info("%s exited with %s", name, proc.wait())

    # -- stop -------------------------------------------------------------

    def do_stop(self):
        session = self.session
        if session and session.poll() is None:
            run_user([WAYDROID, "session", "stop"], timeout=60, check=False)
            try:
                session.wait(timeout=30)
            except subprocess.TimeoutExpired:
                session.terminate()
                session.wait(timeout=10)
        self.ready.clear()
        return None

    def shutdown(self):
        """Stops everything (logout or shutdown); the job may be killed soon."""
        self.stopping = True
        log.info("Shutting down")
        with self.lock:
            self.busy = "stop"
        try:
            self.do_stop()
        except Exception:  # pylint: disable=broad-except
            log.exception("stopping Android")
        for proc in (self.container, self.bus):
            if proc and proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    proc.kill()
        if is_mounted(WORK):
            run(["umount", "-l", WORK], check=False, timeout=60)

    # -- apps -------------------------------------------------------------

    def do_install(self, path, name):
        try:
            if not self.running():
                self.do_start(show=False)
            before = app_files()
            for _ in range(15):
                # Until Waydroid has rewritten every app's file after a start.
                time.sleep(1)
                now, before = before, app_files()
                if now == before:
                    break
            self.set_step("install")
            p = run_user([WAYDROID, "app", "install", path], timeout=600, check=False)
            out = (p.stdout or "").strip()
            # `waydroid app install` prints nothing when it works; its
            # errors ("Failed to access IPlatform service", "WayDroid
            # session is stopped", a traceback) still exit with 0.
            if p.returncode != 0 or re.search(r"rror|Failed|stopped|Traceback", out):
                raise Failure("install_failed", out[-500:])
            for _ in range(60):
                # A new file for a new app, a newer one for an update. Apps
                # without a launcher icon get none.
                changed = {f for f, t in app_files().items() if before.get(f) != t}
                apps = [a for a in list_apps()
                        if f"{APPS_DIR}/waydroid.{a['package']}.desktop" in changed]
                if apps:
                    return {"code": "installed", "detail": apps[0]["name"]}
                time.sleep(1)
            return {"code": "install_sent", "detail": name}
        finally:
            try:
                os.unlink(path)
            except OSError:
                pass


def checks():
    """What the kernel and image provide; the page explains what is missing."""
    filesystems = read_file("/proc/filesystems")
    return {
        "binder": re.search(r"\sbinder$", filesystems, re.M) is not None,
        "waydroid": os.access(WAYDROID, os.X_OK),
        "wayland": os.path.exists(f"{WAYLAND_DIR}/{WAYLAND_DISPLAY}"),
    }


def kill_pidfile(path, name):
    try:
        pid = int(read_file(path))
    except ValueError:
        return
    if name in read_file(f"/proc/{pid}/cmdline").replace("\0", " "):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass


# ---------------------------------------------------------------------------
# HTTP

CONTENT_TYPES = {
    ".html": "text/html; charset=utf-8",
    ".js": "text/javascript; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".webmanifest": "application/manifest+json",
    ".png": "image/png",
    ".svg": "image/svg+xml",
}
STATIC = {"/": "index.html", "/index.html": "index.html", "/app.js": "app.js",
          "/style.css": "style.css", "/manifest.webmanifest": "manifest.webmanifest",
          "/sw.js": "sw.js", "/icon.svg": "icon.svg"}
CSP = ("default-src 'self'; img-src 'self' data:; style-src 'self'; "
       "script-src 'self'; connect-src 'self'; frame-ancestors 'none'")


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "pinebook-android"
    protocol_version = "HTTP/1.1"
    android = None  # set by serve()

    def log_message(self, fmt, *args):  # pylint: disable=arguments-differ
        pass

    def send(self, code, body=b"", ctype="text/plain; charset=utf-8", extra=None):
        if isinstance(body, str):
            body = body.encode()
        if code >= 400:
            # The request body may not have been read; do not parse it as
            # the next request.
            self.close_connection = True
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        if self.close_connection:
            self.send_header("Connection", "close")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def send_json(self, obj, code=200):
        self.send(code, json.dumps(obj), "application/json")

    def host_ok(self):
        host = (self.headers.get("Host") or "").lower()
        host = re.sub(r":80$", "", host)
        return host in HOSTS

    def do_GET(self):  # pylint: disable=invalid-name
        if not self.host_ok():
            return self.send(421, "Use http://android.localhost/\n")
        path = urllib.parse.urlsplit(self.path).path
        if path in STATIC:
            name = STATIC[path]
            try:
                with open(f"{SHARE}/web/{name}", "rb") as f:
                    body = f.read()
            except OSError:
                return self.send(404, "not found\n")
            extra = {"Content-Security-Policy": CSP} if name.endswith(".html") else {}
            return self.send(200, body, CONTENT_TYPES[os.path.splitext(name)[1]], extra)
        if path == "/icon.png":
            return self.send_file(WAYDROID_ICON, "/icon.svg")
        m = re.fullmatch(r"/icons/([A-Za-z0-9_.]+)\.png", path)
        if m and PACKAGE_RE.match(m.group(1)):
            return self.send_file(f"{ICONS_DIR}/{m.group(1)}.png")
        if path == "/api/status":
            return self.send_json(self.android.status())
        if path == "/api/log":
            lines = list(recent) + ["", "--- " + WORK + "/waydroid.log ---"]
            lines += [l.rstrip("\n") for l in tail(WORK + "/waydroid.log")]
            return self.send(200, "\n".join(lines) + "\n")
        return self.send(404, "not found\n")

    do_HEAD = do_GET

    def send_file(self, path, fallback=None):
        try:
            with open(path, "rb") as f:
                body = f.read()
        except OSError:
            if fallback:
                return self.send(302, "", extra={"Location": fallback})
            return self.send(404, "not found\n")
        return self.send(200, body, "image/png", {"Cache-Control": "max-age=60"})

    def do_POST(self):  # pylint: disable=invalid-name
        if not self.host_ok():
            return self.send(421, "Use http://android.localhost/\n")
        origin = self.headers.get("Origin")
        if origin and origin.lower() != "http://" + (self.headers.get("Host") or "").lower():
            return self.send(403, "cross-origin request\n")
        if self.headers.get(API_HEADER) != "1":
            return self.send(403, f"missing {API_HEADER} header\n")
        path = urllib.parse.urlsplit(self.path).path
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return self.send(400, "bad Content-Length\n")
        a = self.android
        try:
            if path == "/api/install":
                return self.install(length)
            body = json.loads(self.rfile.read(length) or b"{}") if length else {}
            if path == "/api/setup":
                a.background("setup", a.do_setup, bool(body.get("start", True)),
                             bool(body.get("google_play", False)))
            elif path == "/api/android-id":
                if not a.running():
                    raise Failure("not_running")
                return self.send_json({"android_id": android_id()})
            elif path == "/api/start":
                a.background("start", a.do_start, True)
            elif path == "/api/launch":
                package = str(body.get("package", ""))
                if not PACKAGE_RE.match(package):
                    return self.send(400, "bad package name\n")
                if a.running():
                    run_user([WAYDROID, "app", "launch", package], timeout=60)
                else:
                    a.background("start", a.do_start, True, package)
            elif path == "/api/stop":
                a.background("stop", a.do_stop)
            else:
                return self.send(404, "not found\n")
        except Failure as e:
            return self.send_json({"error": {"code": e.code, "detail": e.detail}}, 409)
        except ValueError:
            return self.send(400, "bad request\n")
        return self.send_json(a.status())

    def install(self, length):
        if not 0 < length <= MAX_APK:
            return self.send(413, "the file must be a non-empty APK under 4 GB\n")
        name = os.path.basename(urllib.parse.unquote(self.headers.get("X-File-Name") or "app.apk"))
        a = self.android
        if not is_mounted(WORK) or not is_initialized():
            self.rfile.read(length)
            raise Failure("not_set_up")
        path = f"{INCOMING}/{uuid.uuid4().hex}.apk"
        pw = chronos()
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        try:
            os.fchown(fd, pw.pw_uid, pw.pw_gid)
            with os.fdopen(fd, "wb") as f:
                left = length
                while left:
                    chunk = self.rfile.read(min(left, 1 << 20))
                    if not chunk:
                        raise Failure("upload", "the upload was cut short")
                    f.write(chunk)
                    left -= len(chunk)
            with open(path, "rb") as f:
                if f.read(4) != b"PK\x03\x04":
                    raise Failure("not_apk", name)
            a.background("install", a.do_install, path, name)
        except Exception:
            try:
                os.unlink(path)
            except OSError:
                pass
            raise
        return self.send_json(a.status())


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


class Server6(Server):
    address_family = socket.AF_INET6


def serve(android):
    Handler.android = android
    servers = [Server(("127.0.0.1", PORT), Handler)]
    try:
        servers.append(Server6(("::1", PORT), Handler))
    except OSError as e:
        log.info("Not listening on [::1]:%d: %s", PORT, e)
    for s in servers[1:]:
        threading.Thread(target=s.serve_forever, daemon=True).start()
    log.info("Listening on http://android.localhost/")
    return servers


def daemon():
    setup_logging(to_file=True)
    android = Android()
    try:
        if mount_data():
            log.info("%s is mounted at %s", PART_LABEL, WORK)
    except Failure as e:
        log.error("Mounting %s: %s", PART_LABEL, e)
        android.error = {"code": e.code, "detail": e.detail}
    servers = serve(android)

    def on_term(signum, frame):  # pylint: disable=unused-argument
        threading.Thread(target=lambda: (android.shutdown(), os._exit(0)),
                         daemon=True).start()

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    servers[0].serve_forever()


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("daemon", help="run the service (upstart job pinebook-android)")
    sub.add_parser("info", help="print the boot disk and the free space for Android")
    args = parser.parse_args()
    if args.cmd == "daemon":
        daemon()
    elif args.cmd == "info":
        print(json.dumps(partition_info(), indent=2))


if __name__ == "__main__":
    main()
