# Pinebook Pro: Rockchip RK3399 (2x Cortex-A72 + 4x Cortex-A53), 4 GB LPDDR4,
# 64-bit (arm64) userland. Inherits arm64-generic (profiles/base/parent) and
# overrides the CPU, kernel and GPU settings.

BOARD_COMPILER_FLAGS="-march=armv8-a+crc+crypto -mtune=cortex-a53"

# ChromeOS kernel 6.6 with device tree support, RK3399 Chromebook (gru)
# splitconfig flavour; profile.bashrc merges kernel/pinebook-pro.config on top.
CHROMEOS_KERNEL_ARCH="arm64"
CHROMEOS_KERNEL_SPLITCONFIG="chromiumos-rockchip64"
USE="${USE} -kernel-5_15 kernel-6_6 device_tree"

# Mali-T860 through the open Panfrost driver (media-libs/mesa-panfrost, see
# virtual/opengles); rockchip selects the minigbm backend for the RK3399 VOP.
VIDEO_CARDS="panfrost rockchip"

# Real hardware, not a VM: no virtual KMS driver.
USE="${USE} -vkms"
