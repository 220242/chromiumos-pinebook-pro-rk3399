# Pinebook Pro (RK3399) kernel config fragment.
#
# Merged on top of the ChromeOS kernel splitconfig by profiles/base/profile.bashrc
# (see kernel/apply-fragment.sh). Written for the upstream device tree
# arch/arm64/boot/dts/rockchip/rk3399-pinebook-pro.dts and checked against
# Linux 6.6 (arm64 defconfig + this fragment, every symbol below survives
# olddefconfig).
#
# Anything needed to mount the root filesystem from eMMC or microSD without an
# initramfs is built in (=y). Drivers that load firmware from the root
# filesystem (Wi-Fi, Bluetooth) or are large and not needed at boot are modules.

# SoC
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_NVMEM_ROCKCHIP_EFUSE=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_I2C_RK3X=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_RK3399_DMC_DEVFREQ=y

# PMIC (RK808), CPU regulators (SYR827/SYR828), PWM regulator
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_RTC_DRV_RK808=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_REGULATOR_PWM=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Storage: eMMC (SDHCI Arasan), microSD and SDIO (DW MMC), NVMe on the one
# PCIe controller (pcie0)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_PHY_ROCKCHIP_EMMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_PCI=y
CONFIG_PCIE_ROCKCHIP_HOST=y
CONFIG_PHY_ROCKCHIP_PCIE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_EXT4_FS=y
# CONFIG_EXT2_FS is not set
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y

# USB, USB-C (FUSB302) and the internal keyboard/touchpad (USB HID)
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_TYPEC=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_FUSB302=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_USB_STORAGE=y

# Display: VOP, eDP panel (BOE NV140FHM-N49), PWM backlight, DP alt mode, GPU
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_ANALOGIX_DP=y
CONFIG_ROCKCHIP_CDN_DP=y
CONFIG_DRM_PANEL_EDP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_PANFROST=m

# Video decode/encode and 2D
CONFIG_MEDIA_SUPPORT=m
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_HANTRO=m
CONFIG_VIDEO_HANTRO_ROCKCHIP=y
CONFIG_VIDEO_ROCKCHIP_RGA=m

# Audio: ES8316 codec on I2S0, speaker amplifier, simple-audio-card
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_ES8316=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
CONFIG_SND_SIMPLE_CARD=y

# Wi-Fi and Bluetooth: AMPAK AP6256 (Broadcom BCM43456), Wi-Fi over SDIO,
# Bluetooth over UART0
CONFIG_CFG80211=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# Battery (CW2015), charger, lid switch and power button, LEDs
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_CW2015=y
CONFIG_CHARGER_GPIO=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y

# Taken from the working mainline RK3399 config of the Khadas Edge-V
# Android TV 14 build (same SoC): SoC core, DMA for I2S audio, thermal and
# devfreq (also used by Panfrost), CPU idle, watchdog, RTC, rkvdec video
# decoder (staging in 6.6) and DisplayPort alt mode on USB-C.
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK3399=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_ROCKCHIP_GRF=y
CONFIG_ROCKCHIP_TIMER=y
CONFIG_PL330_DMA=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_RTC_CLASS=y
CONFIG_EXTCON=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_VIDEO_ROCKCHIP_VDEC=m
