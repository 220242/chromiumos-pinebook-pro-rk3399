# Shell scripts run inside Linux/WSL and break with CRLF line endings,
# even when the repository is cloned on Windows.
*.sh     text eol=lf
*.conf   text eol=lf
*.config text eol=lf
*.dts    text eol=lf
*.ps1    text eol=crlf
# Everything in the board overlay and the Linux build scripts is read by
# bash or portage inside WSL/the SDK, whatever the file name.
boards/**     text eol=lf
build/linux/** text eol=lf
